

---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';


---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11110f" />
    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #11110f;
        --panel: #1b1b18;
        --text: #f0efe8;
        --muted: #aaa99f;
        --line: #383830;
        --accent: #d5ff65;
      }

      * { box-sizing: border-box; }
      html { background: var(--bg); scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, system-ui, sans-serif;
      }
      a { color: inherit; }
      main.archive {
        width: min(1440px, calc(100% - 48px));
        margin: 0 auto;
        padding-bottom: 64px;
      }
      .hero {
        min-height: 390px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: clamp(28px, 7vw, 84px);
        margin: 24px 0 76px;
        border-radius: 12px;
        overflow: hidden;
        background:
          linear-gradient(90deg, rgba(0,0,0,.75), rgba(0,0,0,.08)),
          linear-gradient(0deg, rgba(0,0,0,.45), transparent),
          url('https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=2200&q=85') center 48% / cover,
          #292923;
      }
      .eyebrow {
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: .16em;
        font-size: .72rem;
        font-weight: 700;
      }
      .hero h1 {
        margin: 18px 0;
        max-width: 1000px;
        font-size: clamp(3.2rem, 9vw, 7.5rem);
        line-height: .88;
        letter-spacing: -.075em;
        font-weight: 750;
      }
      .hero p { max-width: 520px; color: #e0dfd7; line-height: 1.7; }
      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 24px;
      }
      .section-head h2 {
        margin: 10px 0 0;
        font-size: clamp(1.8rem, 4vw, 3rem);
        letter-spacing: -.05em;
      }
      #count { color: var(--muted); font-size: .85rem; white-space: nowrap; }
      .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 30px; }
      .filters button, .read-more {
        border: 1px solid var(--line);
        border-radius: 99px;
        background: transparent;
        color: var(--text);
        padding: 9px 16px;
        cursor: pointer;
        font: inherit;
        font-size: .82rem;
      }
      .filters button.active, .filters button:hover {
        color: var(--bg);
        background: var(--accent);
        border-color: var(--accent);
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        align-items: start;
      }
      .date-separator {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 24px;
        color: var(--muted);
        font-size: .75rem;
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      .date-separator::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--line);
      }
      .loading, .error {
        grid-column: 1 / -1;
        color: var(--muted);
        padding: 24px 0;
      }
      .card {
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--panel);
      }
      .media {
        aspect-ratio: 4 / 3;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #252520;
      }
      .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .media iframe { width: 100%; height: 100%; border: 0; }
      .media.instagram { aspect-ratio: 4 / 5; }
      .article-cover {
        padding: 24px;
        align-items: end;
        justify-content: start;
        background: linear-gradient(135deg, #37392e, #171815);
      }
      .article-cover span {
        font-size: clamp(1.6rem, 3vw, 2.6rem);
        line-height: 1;
        letter-spacing: -.05em;
        font-weight: 750;
      }
      .card-body { padding: 18px; }
      .meta {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        color: var(--muted);
        font-size: .7rem;
        letter-spacing: .1em;
        text-transform: uppercase;
      }
      .card h3 { margin: 12px 0 8px; font-size: 1.2rem; letter-spacing: -.025em; }
      .card p { margin: 0; color: #c5c4bb; font-size: .9rem; line-height: 1.6; }
      .source {
        display: inline-block;
        margin-top: 16px;
        color: var(--accent);
        font-size: .82rem;
        text-decoration: none;
      }
      .source:hover { text-decoration: underline; }
      .read-more { margin-top: 15px; }
      .article-body {
        display: none;
        padding: 0 18px 20px;
        color: #d5d4cb;
        line-height: 1.7;
        white-space: pre-line;
      }
      .article-body.open { display: block; }
      .empty { display: none; color: var(--muted); padding: 30px 0; }
      @media (max-width: 850px) {
        .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .hero { min-height: 320px; margin-bottom: 52px; }
      }
      @media (max-width: 560px) {
        main.archive { width: calc(100% - 24px); }
        .grid { grid-template-columns: 1fr; gap: 14px; }
        .hero { min-height: 300px; padding: 25px; margin: 16px 0 44px; }
      }
    </style>
  </head>
  <body>
    <Header />

    <main class="archive">
      <section class="hero">
        <div class="eyebrow">Archives visuelles · 2026</div>
        <h1>Images,<br />idées & traces.</h1>
        <p>Une collection en mouvement. Vidéos, images et textes réunis au même endroit.</p>
      </section>

      <section aria-labelledby="collection-title">
        <div class="section-head">
          <div>
            <div class="eyebrow">La collection</div>
            <h2 id="collection-title">Explorer les contenus</h2>
          </div>
          <span id="count" aria-live="polite"></span>
        </div>

        <nav class="filters" aria-label="Filtrer les contenus">
          <button class="active" type="button" data-filter="Tous">Tout</button>
          <button type="button" data-filter="Vidéo">Vidéos</button>
          <button type="button" data-filter="Image">Images</button>
          <button type="button" data-filter="Article">Articles</button>
        </nav>

        <div class="grid" id="grid">
          <p class="loading">Chargement de la collection…</p>
        </div>
        <p class="empty" id="empty">Aucun contenu dans cette catégorie.</p>
      </section>
    </main>

    <script>
      const grid = document.querySelector('#grid');
      const count = document.querySelector('#count');
      const empty = document.querySelector('#empty');

      let publications = [];
      let activeFilter = 'Tous';

      const typeLabels = {
        video: 'Vidéo',
        image: 'Image',
        article: 'Article',
      };

      function parseDate(value) {
        if (!value) return null;
        const normalized = value.includes('T') ? value : value.replace(' ', 'T') + 'Z';
        const date = new Date(normalized);
        return Number.isNaN(date.getTime()) ? null : date;
      }

      function formatDate(value) {
        const date = parseDate(value);
        if (!date) return 'Date inconnue';
        return new Intl.DateTimeFormat('fr-FR', {
          day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris',
        }).format(date);
      }

      function dayKey(value) {
        const date = parseDate(value);
        if (!date) return 'unknown';
        return new Intl.DateTimeFormat('sv-SE', {
          timeZone: 'Europe/Paris', year: 'numeric', month: '2-digit', day: '2-digit',
        }).format(date);
      }

      function element(tag, className, text) {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (text !== undefined) node.textContent = text;
        return node;
      }

      function safeLink(value) {
        try {
          const url = new URL(value);
          return ['https:', 'http:'].includes(url.protocol) ? url.href : null;
        } catch {
          return null;
        }
      }

      function createCard(item) {
        const card = element('article', 'card');
        const type = typeLabels[item.content_type] || 'Article';
        card.dataset.type = type;
        const sourceUrl = safeLink(item.source_url || '');
        const thumbnailUrl = safeLink(item.thumbnail_url || '');
        const title = item.title || 'Sans titre';

        if (thumbnailUrl) {
          const media = element('div', 'media');
          const img = element('img');
          img.src = thumbnailUrl;
          img.alt = title;
          img.loading = 'lazy';
          media.append(img);
          card.append(media);
        } else if (item.content_type === 'video' && sourceUrl) {
          const media = element('div', 'media instagram');
          let match = null;
          try {
            const url = new URL(sourceUrl);
            if (['instagram.com', 'www.instagram.com'].includes(url.hostname)) {
              match = url.pathname.match(/^\/(reel|p|tv)\/([^/]+)/);
            }
          } catch {}

          if (match) {
            const iframe = element('iframe');
            iframe.src = `https://www.instagram.com/${match[1]}/${match[2]}/embed`;
            iframe.loading = 'lazy';
            iframe.title = title;
            iframe.setAttribute('allowfullscreen', '');
            media.append(iframe);
          } else {
            media.append(element('span', '', 'Vidéo'));
          }
          card.append(media);
        } else {
          const cover = element('div', 'media article-cover');
          cover.append(element('span', '', title));
          card.append(cover);
        }

        const body = element('div', 'card-body');
        const meta = element('div', 'meta');
        meta.append(element('span', '', type), element('span', '', formatDate(item.published_at)));
        body.append(meta, element('h3', '', title), element('p', '', item.description || ''));

        if (sourceUrl) {
          const link = element('a', 'source', 'Voir la source ↗');
          link.href = sourceUrl;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          body.append(link);
        }
        card.append(body);
        return card;
      }

      function renderGallery() {
        grid.replaceChildren();
        const filtered = publications.filter((item) => {
          const type = typeLabels[item.content_type] || 'Article';
          return activeFilter === 'Tous' || type === activeFilter;
        });
        count.textContent = `${filtered.length} contenu${filtered.length > 1 ? 's' : ''}`;
        empty.style.display = filtered.length ? 'none' : 'block';
        if (!filtered.length) return;

        let previousDay = null;
        for (const item of filtered) {
          const key = dayKey(item.published_at);
          if (key !== previousDay) {
            grid.append(element('div', 'date-separator', formatDate(item.published_at)));
            previousDay = key;
          }
          grid.append(createCard(item));
        }
      }

      document.querySelectorAll('[data-filter]').forEach((button) => {
        button.addEventListener('click', () => {
          activeFilter = button.dataset.filter;
          document.querySelectorAll('[data-filter]').forEach((item) => {
            item.classList.toggle('active', item === button);
          });
          renderGallery();
        });
      });

      async function loadGallery() {
        try {
          const response = await fetch('/api/publications.json', { cache: 'no-store' });
          if (!response.ok) throw new Error(`Erreur HTTP ${response.status}`);
          const data = await response.json();
          if (!Array.isArray(data)) throw new Error('Réponse API invalide');
          publications = data.sort((a, b) => {
            return (parseDate(b.published_at)?.getTime() || 0) - (parseDate(a.published_at)?.getTime() || 0);
          });
          renderGallery();
        } catch (error) {
          console.error('Erreur de chargement de la galerie :', error);
          grid.replaceChildren(element('p', 'error', 'Impossible de charger la collection. Réessaie plus tard.'));
          count.textContent = '';
          empty.style.display = 'none';
        }
      }

      loadGallery();
    </script>

    <Footer />
  </body>
</html>
